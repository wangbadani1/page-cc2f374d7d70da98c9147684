border:1px solid #e0d4bc;border-radius:6px;overflow:hidden}\n.plan.featured{border-color:var(--mint-deep);box-shadow:0 4px 0 var(--mint)}\n.plan-head{background: var(--paper);padding: 32px 28px;display:flex;flex-direction:column;justify-content:space-between}\n.plan.featured .plan-head{background:var(--brown-deep);color:var(--cream)}\n.plan-name{font-size:20px;font-weight:700;color:var(--brown-deep)}\n.plan.featured .plan-name{color:var(--mint)}\n.plan-price{font-size:28px;font-weight:800;color:var(--brown-deep);margin-top:10px}\n.plan.featured .plan-price{color:var(--cream)}\n.plan-price small{font-size:13px;font-weight:500;color:var(--ink-soft)}\n.plan.featured .plan-price small{color:rgba(244,237,226,.7)}\n.plan-annual{font-size:12px;color:var(--mint-deep);margin-top:10px;letter-spacing:.06em}\n.plan.featured .plan-annual{color:var(--mint)}\n.plan-body{padding: 32px 28px}\n.plan-body ul{list-style:none;display:flex;flex-direction:column;gap:10px}\n.plan-body li{font-size:14px;color:var(--ink);padding-left: 22px;position:relative}\n.plan-body li::before{content:\"\";position:absolute;left:0;top:9px;width:10px;height:10px;background:var(--mint);border-radius:50%}\n.plan-flag{display:inline-block;font-size:11px;background:var(--mint-deep);color:#fff;padding:3px 10px;border-radius:2px;margin-bottom:12px;letter-spacing:.1em}\n\n/* FAQ：details 折叠 */\n.faq{display:flex;flex-direction:column;gap:12px;max-width:860px}\n.faq details{background:#fff;border:1px solid #e0d4bc;border-radius:4px;padding: 0}\n.faq summary{cursor:pointer;padding: 18px 24px;font-size:15px;font-weight:600;color:var(--brown-deep);list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}\n.faq summary::-webkit-details-marker{display:none}\n.faq summary::after{content:\"+\";color:var(--mint-deep);font-size:20px;font-weight:700;flex-shrink:0}\n.faq details[open] summary::after{content:\"–\"}\n.faq details[open] summary{border-bottom:1px solid #ece3d2;background:var(--paper)}\n.faq .answer{padding: 18px 24px 22px;font-size:14px;color:var(--ink-soft);line-height:1.7}\n\n/* 使用说明 */\n.steps{display:flex;flex-direction:column;gap:20px}\n.step{display:grid;grid-template-columns: 40px 1fr;gap:18px;padding-bottom:20px;border-bottom:1px dashed #d8c9ac}\n.step:last-child{border-bottom:none}\n.step .n{font-size:18px;font-weight:800;color:var(--mint-deep)}\n.step h3{font-size:16px;margin-bottom:6px;color:var(--brown-deep)}\n.step p{font-size:14px;color:var(--ink-soft)}\n\n/* 客户端 */\n.clients{display:grid;grid-template-columns: repeat(auto-fit, minmax(220px,1fr));gap:18px}\n.client{background:#fff;border:1px solid #e0d4bc;padding:22px;border-radius:4px}\n.client h3{font-size:15px;color:var(--brown-deep);margin-bottom:6px}\n.client p{font-size:13px;color:var(--ink-soft)}\n\nfooter{background:var(--brown-deep);color:rgba(244,237,226,.6);padding:40px 24px;font-size:12px;text-align:center;letter-spacing:.06em}\nfooter strong{color:var(--mint);font-weight:600}\n\n@media (max-width: 760px){\n  .hero{grid-template-columns:1fr;min-height:auto}\n  .hero-left{padding:48px 24px}\n  .hero-right{padding:48px 24px}\n  .hero-footmark{position:static;margin-bottom:20px}\n  .plan{grid-template-columns:1fr}\n  section{padding:56px 18px}\n  .topnav{flex-direction:column;align-items:flex-start}\n  .toc{margin-left:0}\n}\n</style><nav class=\"topnav\" aria-label=\"主导航\">\n  <div class=\"crumbs\">\n    <span>首页</span>\n    <span>产品</span>\n    <span>星辰加速</span>\n  </div>\n  <div class=\"toc\">\n    <a href=\"#about\">关于</a>\n    <a href=\"#plans\">订阅方案</a>\n    <a href=\"#usage\">使用说明</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>\n\n<main>\n\n<header class=\"hero\">\n  <div class=\"hero-left\">\n    <div>\n      <div class=\"hero-eyebrow\">Starlinkboost / 订阅服务</div>\n      <h1>星辰加速(starlinkboost) · \n        星辰加速\n        <span class=\"en\">STARLINKBOOST</span>\n      </h1>\n      <p class=\"hero-lead\">面向日常网络环境优化的轻量转发服务，覆盖路由调度、跨区访问与流媒体区域适配等常见场景。</p>\n    </div>\n    <div class=\"hero-meta\">服务编号 SLB-2518 · 订阅制 · 按月或按年续费</div>\n  </div>\n  <div class=\"hero-right\">\n    <div class=\"hero-footmark\">没有营销话术，只有可读的说明</div>\n    <blockquote class=\"hero-quote\">\n      你的网络体验，是不是经常被\"看运气\"三个字概括？我们尝试把这件事变得可预期。\n    </blockquote>\n  </div>\n</header>\n\n<section id=\"about\">\n  <h2 class=\"h2\">这套服务在做什么</h2>\n  <div class=\"h2-en\">About Starlinkboost</div>\n  <p class=\"h-intro\">\n    星辰加速（starlinkboost）是一套基于订阅的网络转发与路由优化工具。它并不承诺\"极速\"或\"破解\"，而是把节点调度、区域适配、带宽分配这些原本只能靠运气的事，变成一份可以阅读、可以对比、可以退订的普通服务。\n  </p>\n\n  <div class=\"cards\">\n    <article class=\"num-card\">\n      <span class=\"tag\">场景一</span>\n      <h3>跨区访问的日常需求</h3>\n      <p>对不同地区的公开网络资源进行路由转发，减少因地理距离造成的延迟波动，让访问结果更稳定可预期。</p>\n      <div class=\"big-num\">01</div>\n    </article>\n    <article class=\"num-card\">\n      <span class=\"tag\">场景二</span>\n      <h3>流媒体区域适配</h3>\n      <p>针对主流公开流媒体平台的区域限制，提供原生线路与中转线路两种模式，由用户根据订阅方案自行选择。</p>\n      <div class=\"big-num\">02</div>\n    </article>\n    <article class=\"num-card\">\n      <span class=\"tag\">场景三</span>\n      <h3>多设备日常并行</h3>\n      <p>同一账号下支持多台设备并行使用，适合家庭共享、小型团队协作等常见场景，账号额度按套餐分级。</p>\n      <div class=\"big-num\">03</div>\n    </article>\n    <article class=\"num-card\">\n      <span class=\"tag\">场景四</span>\n      <h3>团队带宽管理</h3>\n      <p>面向团队版用户提供高带宽节点池与定制路由选项，便于多人协作环境下对延迟与稳定性的统一要求。</p>\n      <div class=\"big-num\">04</div>\n    </article>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <h2 class=\"h2\">订阅方案</h2>\n  <div class=\"h2-en\">Plans</div>\n  <p class=\"h-intro\">\n    三档方案按流量额度与设备数区分，价格按月计算，按年订阅另有折扣。所有方案共享同一节点网络，差异在于流量、设备数与优先级。\n  </p>\n\n  <div class=\"plans\">\n\n    <article class=\"plan\">\n      <div class=\"plan-head\">\n        <div>\n          <div class=\"plan-name\">基础版</div>\n          <div class=\"plan-price\">¥15<small>/月</small></div>\n        </div>\n        <div class=\"plan-annual\">按年付仅需 ¥150/年</div>\n      </div>\n      <div class=\"plan-body\">\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"plan featured\">\n      <div class=\"plan-head\">\n        <div>\n          <span class=\"plan-flag\">推荐</span>\n          <div class=\"plan-name\">旗舰版</div>\n          <div class=\"plan-price\">¥35<small>/月</small></div>\n        </div>\n        <div class=\"plan-annual\">按年付仅需 ¥350/年</div>\n      </div>\n      <div class=\"plan-body\">\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </div>\n    </article>\n\n    <article class=\"plan\">\n      <div class=\"plan-head\">\n        <div>\n          <div class=\"plan-name\">团队版</div>\n          <div class=\"plan-price\">¥85<small>/月</small></div>\n        </div>\n        <div class=\"plan-annual\">按年付仅需 ¥850/年</div>\n      </div>\n      <div class=\"plan-body\">\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </div>\n    </article>\n\n  </div>\n</section>\n\n<section id=\"usage\">\n  <h2 class=\"h2\">使用说明</h2>\n  <div class=\"h2-en\">How to Use</div>\n  <p class=\"h-intro\">\n    从订阅到首次连接，整个过程大约需要十分钟。下面按顺序列出每一步要做什么，以及在哪里可能遇到问题。\n  </p>\n\n  <div class=\"steps\">\n    <div class=\"step\">\n      <div class=\"n\">01</div>\n      <div>\n        <h3>选择订阅方案</h3>\n        <p>根据每月大致流量需求和同时在线设备数选择对应档位。如果主要用于流媒体观看，建议从旗舰版起步；多人协作场景可考虑团队版。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"n\">02</div>\n      <div>\n        <h3>获取订阅链接</h3>\n        <p>订阅成功后，账号中心会生成一条专属订阅链接。这条链接是后续客户端导入节点配置的凭据，请勿公开分享。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"n\">03</div>\n      <div>\n        <h3>下载并安装客户端</h3>\n        <p>根据设备系统选择对应客户端，常见平台均可使用。安装完成后打开客户端，进入节点导入界面。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"n\">04</div>\n      <div>\n        <h3>导入订阅并连接</h3>\n        <p>将订阅链接粘贴到客户端的订阅地址栏，点击更新即可拉取最新节点列表。选择一个延迟较低的节点，点击连接。</p>\n      </div>\n    </div>\n    <div class=\"step\">\n      <div class=\"n\">05</div>\n      <div>\n        <h3>遇到问题怎么办</h3>\n        <p>连接失败、速度异常或区域未解锁等情况，可先在客户端切换其他节点重试；仍无法解决时通过工单提交问题，工单响应时间按订阅档位区分。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <h2 class=\"h2\">客户端说明</h2>\n  <div class=\"h2-en\">Clients</div>\n  <p class=\"h-intro\">\n    星辰加速采用通用订阅格式，兼容主流开源客户端。以下平台均可使用，用户根据自身设备选择即可，不强制指定单一软件。\n  </p>\n\n  <div class=\"clients\">\n    <article class=\"client\">\n      <h3>Windows</h3>\n      <p>支持基于通用订阅协议的开源客户端，导入订阅链接后自动更新节点列表。</p>\n    </article>\n    <article class=\"client\">\n      <h3>macOS</h3>\n      <p>兼容主流开源客户端，建议使用系统级代理模式以覆盖全部应用流量。</p>\n    </article>\n    <article class=\"client\">\n      <h3>Android</h3>\n      <p>支持通用订阅格式客户端，可在应用商店搜索对应开源项目获取安装包。</p>\n    </article>\n    <article class=\"client\">\n      <h3>iOS</h3>\n      <p>需使用 App Store 中支持订阅协议的第三方客户端，部分客户端可能为付费应用。</p>\n    </article>\n    <article class=\"client\">\n      <h3>Linux</h3>\n      <p>支持命令行客户端与图形界面客户端，适合进阶用户与服务器部署场景。</p>\n    </article>\n    <article class=\"client\">\n      <h3>路由器</h3>\n      <p>兼容支持订阅协议的路由器固件，可实现全家网络统一转发，需具备一定网络配置基础。</p>\n    </article>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <h2 class=\"h2\">常见问题</h2>\n  <div class=\"h2-en\">FAQ</div>\n  <p class=\"h-intro\">\n    把大家最常问的几件事整理在下面。如果你的问题不在这里，可以通过工单系统提交。\n  </p>\n\n  <div class=\"faq\">\n\n    <details>\n      <summary>流量按月重置还是累计？</summary>\n      <div class=\"answer\">\n        流量按自然月重置，每月 1 日 0 点恢复额度。当月未使用完的流量不会累计到下月。按年订阅同样按月计算流量，并非全年总量。\n      </div>\n    </details>\n\n    <details>\n      <summary>同时在线设备数超出限制会怎样？</summary>\n      <div class=\"answer\">\n        当连接设备数超过套餐上限时，新设备将无法建立连接，已连接设备不受影响。建议在账号中心查看当前在线设备列表，必要时远程下线旧设备。\n      </div>\n    </details>\n\n    <details>\n      <summary>可以随时升级或降级套餐吗？</summary>\n      <div class=\"answer\">\n        可以。升级套餐按剩余时长补差价，立即生效；降级套餐在当前周期结束后生效，当前周期内仍按原套餐权益使用。\n      </div>\n    </details>\n\n    <details>\n      <summary>订阅支持退款吗？</summary>\n      <div class=\"answer\">\n        订阅开通后 24 小时内且流量使用不超过 1GB，可申请全额退款。超过此条件后一般不再受理退款，特殊情况可通过工单说明。\n      </div>\n    </details>\n\n    <details>\n      <summary>节点速度不理想怎么办？</summary>\n      <div class=\"answer\">\n        先尝试切换同一区域的其他节点；如果问题持续，可在客户端查看节点延迟与丢包率，优先选择延迟低于 150ms 的节点。团队版用户可联系专属客户经理调整路由。\n      </div>\n    </details>\n\n    <details>\n      <summary>流媒体无法解锁是什么原因？</summary>\n      <div class=\"answer\">\n        流媒体解锁与节点线路类型相关。基础版仅支持部分区域，旗舰版与团队版提供全节点原生解锁。若解锁异常，建议先切换节点再重试，仍无效时提交工单排查。\n      </div>\n    </details>\n\n    <details>\n      <summary>订阅链接泄露了怎么办？</summary>\n      <div class=\"answer\">\n        在账号中心点击\"重置订阅链接\"即可生成新链接，旧链接立即失效。建议定期更换订阅链接，避免与他人共享账号。\n      </div>\n    </details>\n\n    <details>\n      <summary>团队版支持子账号管理吗？</summary>\n      <div class=\"answer\">\n        团队版支持在账号中心创建多个子账号，分别分配流量与设备额度。子账号使用独立订阅链接，主账号可统一查看用量明细。\n      </div>\n    </details>\n\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <p><strong>星辰加速 starlinkboost</strong> · 本页面内容为产品说明，不构成任何服务承诺的最终依据，具体权益以订阅时账号中心展示为准。</p>\n</footer>",
